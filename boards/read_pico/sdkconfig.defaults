CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16M.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y

# 实验性组合：MSPI 的 flash 与 PSRAM 共用时钟域，CPU 240MHz 下 IDF 只标定了
# 模块时钟 120MHz，所以 PSRAM 想上 120MHz，flash 必须一起 120MHz。
# 渲染线程逐行读 PSRAM 里的 framebuffer，80MHz 时的实效带宽（约 32MB/s）
# 就是刷新速度的天花板。flash 侧靠 components/read_pico/read_pico_flash_hpm.c
# 补上本机型号的高性能模式。
# 已知风险：上电后温度漂移约 20℃ 会让 PSRAM 访问随机出错。IDF 的温度补偿
# （SPIRAM_TIMING_TUNING_POINT_VIA_TEMPERATURE_SENSOR）只对 flash vendor
# 0xC8/0x20 验证过，本机是 ZB25VQ128(Zbit)，开了会在 do_system_init_fn 里报
# 「flash model has not been verified」直接 abort 并循环重启，所以必须关掉，
# 等于没有这层保护。别改成 y。这一段只在 Read Pico 上成立，换板必须重写。
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_ESPTOOLPY_FLASHFREQ_120M=y
# 显式启用 HPM（AUTO 会因为"依赖具体 flash 型号"报 #warning，-Werror 下编不过）。
# 本机 flash 靠写状态寄存器进入高性能模式，不需要调 dummy cycle，所以关掉 HPM-DC。
CONFIG_SPI_FLASH_HPM_ENA=y
CONFIG_SPI_FLASH_HPM_DC_DISABLE=y
CONFIG_SPIRAM_SPEED_120M=y
CONFIG_SPIRAM_TIMING_TUNING_POINT_VIA_TEMPERATURE_SENSOR=n

# 内部 RAM 保留 32KB：面板 DMA 是连续的，BLE 控制器也只能用内部 RAM。
# Internal RAM reserved 32 KB: the panel DMA is contiguous and the BLE controller also needs
# internal RAM only.
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# 渲染线程逐行流式读 PSRAM 里的 framebuffer，cache 越大预取越不容易失效。
# 这两项是 ESP32-S3 专有，换芯片必须去掉。
# Rendering streams the framebuffer out of PSRAM, so a larger cache misses less on prefetch.
# Both are ESP32-S3 specific and must go when the chip changes.
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_TINYUSB_DESC_PRODUCT_STRING="Read Pico SD"
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="MindReset"
