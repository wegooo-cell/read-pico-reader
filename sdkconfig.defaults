# 通用配置：两块板共用的部分。板级差异一律放 boards/<名字>/sdkconfig.defaults，
# 它在本文件之后追加，因此那里的值优先。
# Shared configuration. Anything board-specific belongs in boards/<name>/sdkconfig.defaults,
# which is appended after this file and therefore wins.

CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# 1ms tick：EPD 上电流程里按毫秒轮询 PGOOD，100Hz 的 tick 会把每次等待放大到 10ms
CONFIG_FREERTOS_HZ=1000
# 长文件名以 UTF-8 交给界面与 fopen；磁盘 LFN 保持 UTF-16，不需要增加 CP936 表。
# Pass long filenames to UI and fopen as UTF-8; on-disk LFN stays UTF-16 without a CP936 table.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_API_ENCODING_UTF_8=y

# 传书热点；优先把网络缓冲放PSRAM，避免占用显示所需内部内存。
# Transfer AP prefers PSRAM network buffers, preserving internal display memory.
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# 只服务一个浏览器客户端并扫描附近热点。高吞吐默认值在 esp_wifi_init() 就预留几十 KB，
# 阅读界面用过之后会把托管的 WiFi 控制路径饿死。
# One browser client and one nearby-AP scan. The high-throughput defaults reserve tens of
# kilobytes at esp_wifi_init(), which can starve the hosted WiFi control path after the reader
# UI has been used.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_STATIC_TX_BUFFER=y
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=4
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_RX_BA_WIN=4
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=16
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=1024

# 蓝牙翻页器：BLE HID 主机（central），配对市面上的 BLE 翻页器／键盘。
# Bluetooth page-turner: a BLE HID host (central) pairing off-the-shelf BLE remotes.
#
# 只用 BLE。两块板都没有 Bluetooth Classic 射频，纯 Classic 的翻页器连不上。
# BLE only. Neither board has a Bluetooth Classic radio, so Classic-only remotes cannot pair.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
# host 的全部动态分配走 PSRAM，内部 RAM 留给面板 DMA 与显示。
# The host allocates from PSRAM, leaving internal RAM to the panel DMA and the display.
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
# 只做 central；用不到的角色连缓冲一起编掉。
# Central only; the unused roles and their buffers are compiled out.
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=4
# bond 密钥必须落 NVS，否则每次重启都要重新配对，自动重连形同虚设。这项默认是 n。
# Bond keys must reach NVS, or every reboot re-pairs and auto-reconnect is useless. Defaults to n.
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_MAX_CCCDS=2
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=23
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=6
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=6
CONFIG_BT_NIMBLE_ACL_BUF_COUNT=6
CONFIG_BT_NIMBLE_ATT_MAX_PREP_ENTRIES=4
# 控制器只能用内部 RAM——它跑在硬件路径上，读不到 PSRAM。这组值是 CrossMux 在 Read Pico 上
# 验证过的：BLE_MAX_ACT 是"同时允许几个控制器活动"，扫描与建立连接各占一个，压到 1 会让
# 扫描和连接互相排斥、栈起不来。
# The controller must stay in internal RAM (it sits on the hardware path and cannot read PSRAM).
# These are the values CrossMux verified on Read Pico: BLE_MAX_ACT is how many controller
# activities may coexist, scanning and connection setup each take one, and squeezing it to 1 makes
# them mutually exclusive so the stack cannot come up.
CONFIG_BT_CTRL_BLE_MAX_ACT=3
CONFIG_BT_CTRL_BLE_ADV_REPORT_FLOW_CTRL_NUM=50
CONFIG_BT_CTRL_ADV_DUP_FILT_MAX=10
CONFIG_BLE_MESH=n

CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# rc76: keep transfer listings and TLS allocations out of internal task RAM.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
